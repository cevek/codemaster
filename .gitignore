tools/grep-analysis/commands.jsonl
tools/grep-analysis/classified.jsonl
tools/grep-analysis/samples/
tasks/.*.tmp
test-timing.html

# Pid-unique child scripts the exit-seam e2e writes beside itself and unlinks on teardown; a run
# interrupted mid-test leaves one behind, and a `git add -A` then commits a test artifact.
test/e2e/*.gen.ts
